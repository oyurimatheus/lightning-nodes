# Copy to .env and adjust. Every value can also live in config/default.toml;
# environment variables always win over the TOML file. Duration values use
# humantime syntax ("5s", "600s", "10m", "1h 30s").

# PostgreSQL connection string (required at runtime)
DATABASE_URL=postgres://lightning:lightning@localhost:5432/lightning

# HTTP server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# External provider
MEMPOOL_BASE_URL=https://mempool.space
MEMPOOL_TIMEOUT=10s

# Synchronization
SYNC_INTERVAL=600s
SYNC_BATCH_SIZE=500
SYNC_ON_STARTUP=true
REJECT_EMPTY_RESPONSE=true

# Database pools
DB_ACQUIRE_TIMEOUT=5s

# Historical retention
HISTORY_RETENTION_DAYS=30
HISTORY_MINIMUM_SUCCESSFUL_SNAPSHOTS=3

# API compatibility switch: false returns the original four-field challenge contract
API_INCLUDE_SAVED_AT=true

# Logging (tracing env filter)
RUST_LOG=info
