# Copie para .env e ajuste conforme necessário. Os valores também podem ser
# definidos em config/default.toml; variáveis de ambiente têm precedência.
# Durações usam a sintaxe humantime ("5s", "600s", "10m", "1h 30s").

# String de conexão do PostgreSQL (obrigatória em tempo de execução)
DATABASE_URL=postgres://lightning:lightning@localhost:5432/lightning

# Credenciais locais do PostgreSQL no Compose (valores apenas para desenvolvimento)
POSTGRES_USER=lightning
POSTGRES_PASSWORD=lightning
POSTGRES_DB=lightning

# Servidor HTTP
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Provedor externo
MEMPOOL_BASE_URL=https://mempool.space
MEMPOOL_TIMEOUT=10s

# Sincronização
SYNC_INTERVAL=600s
SYNC_BATCH_SIZE=500
SYNC_ON_STARTUP=true
REJECT_EMPTY_RESPONSE=true

# Pools do banco de dados
DB_ACQUIRE_TIMEOUT=5s

# Retenção do histórico
HISTORY_RETENTION_DAYS=30
HISTORY_MINIMUM_SUCCESSFUL_SNAPSHOTS=3

# Compatibilidade da API: false retorna os quatro campos do desafio original
API_INCLUDE_SAVED_AT=true

# Logs (filtro de ambiente do tracing)
RUST_LOG=info
